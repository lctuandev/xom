{
  "name": "xom",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d",
    "tunnel": "cloudflared tunnel --url http://localhost:5000",
    "assets": "pnpm --filter @xom/assets build:assets",
    "prepare": "simple-git-hooks",
    "deploy:local": "bash deploy/deploy.sh",
    "tunnel:prod": "cloudflared tunnel --url http://localhost:5555",
    "balance": "pnpm --filter @xom/balance balance",
    "analytics": "pnpm --filter @xom/server analytics"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm typecheck"
  }
}
