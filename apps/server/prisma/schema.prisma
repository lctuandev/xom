generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Tài khoản đăng nhập bằng username + mật khẩu (docs/PLAN.md §3.8).
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
  player       Player?
}

/// Refresh token xoay vòng; chỉ lưu hash.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

/// Nhân vật trong game của một tài khoản.
model Player {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @unique @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String
  roomId           String?   @db.Uuid
  room             Room?     @relation(fields: [roomId], references: [id])
  /// Việc làm thuê đang làm (content job id), null = không đi làm.
  jobId            String?
  /// Bước kịch bản người mới đang ở (content tutorial step id).
  tutorial         String    @default("gap_chu_bay")
  /// Kinh nghiệm tích luỹ từ làm thật (docs/DESIGN.md §4) — cấp độ suy ra từ đây.
  xp               Int       @default(0)
  /// Điểm kỹ năng (DESIGN §4): { tay_nhanh, nho_mon, an_noi } — tăng nhờ làm thật.
  skills           Json      @default("{}")
  /// Thành tựu đã mở: { id: ngày game mở } (content.achievements, UC-P2).
  achievements     Json      @default("{}")
  /// Thưởng đã nhận: { "ach:<id>": ngày, "q:<ngày>:<id>": ngày } (thành tựu một lần, nhiệm vụ mỗi ngày một lần).
  rewardsClaimed   Json      @default("{}")
  /// Mã PIN thẻ ATM (băm sha256 kèm id người chơi) — null = chưa tạo (UC-I6).
  atmPin           String?
  /// Sai PIN quá số lần cho phép: máy giữ thẻ tới hết ngày game này.
  atmLockDay       Int?
  /// Đói / khát (UC-B11): { food, drink, at } — giảm theo giờ game, tính lại khi đọc (sim needsAt).
  needs            Json      @default("{}")
  /// Lần cuối rời xóm (thời gian thật + ngày game) — để tóm tắt "Trong lúc bạn vắng" (THEGIOI §4).
  lastSeenAt       DateTime?
  lastSeenDay      Int?
  /// 🤝 Điểm tin cậy 0–100 (KIENTRUC §3) — tách khỏi uy tín quầy; lên khi giữ lời, xuống khi bỏ việc / thối thiếu.
  trust            Int       @default(50)
  /// Cửa hàng đang quản lý (docs/IA.md bước D — nhiều cửa hàng): mọi thao tác quầy áp cho cửa hàng này.
  activeBusinessId String?   @db.Uuid
  /// Tin cậy quá thấp: khoá nhận việc trên bảng việc xóm tới hết ngày game này.
  trustLockDay     Int?
  /// 🛵 Xe ôm (KIENTRUC §4): ngày game đã thuê xe Wave của Chú Lực; số cuốc đã chạy; tổng sao khách chấm.
  bikeRentDay      Int?
  rides            Int       @default(0)
  rideStars        Int       @default(0)
  /// Việc người chơi thuê (UC-M8): số việc đã được nghiệm thu + tổng sao người thuê chấm.
  gigs             Int       @default(0)
  gigStars         Int       @default(0)
  createdAt        DateTime  @default(now())

  businesses     Business[]
  relations      NpcRelation[]
  inventory      InventoryItem[]
  reports        DailyReport[]
  reviews        Review[]        @relation("ReviewsReceived")
  stories        StoryEntry[]
  residentVisits ResidentVisit[]
}

/// Một "xóm": có đồng hồ riêng. Đăng ký thì có xóm riêng; vào xóm bạn bằng `code` (UC-J1).
model Room {
  id        String        @id @default(uuid(7)) @db.Uuid
  code      String        @unique
  day       Int           @default(1)
  /// Phút trong ngày (game).
  minute    Int
  createdAt DateTime      @default(now())
  players   Player[]
  projects  RoomProject[]
}

enum ProjectStatus {
  VOTING
  FUNDING
  BUILDING
  DONE
  REJECTED
}

/// Công trình chung của xóm (UC-J5): đề xuất → bỏ phiếu → góp quỹ → thi công → nghiệm thu.
model RoomProject {
  id         String        @id @default(uuid(7)) @db.Uuid
  roomId     String        @db.Uuid
  room       Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Id công trình trong content.projects.
  projectId  String
  status     ProjectStatus @default(VOTING)
  proposerId String        @db.Uuid
  /// Phiếu: { playerId: true (thuận) | false (chống) }.
  votes      Json          @default("{}")
  /// Hết hạn bỏ phiếu: ngày + phút game.
  voteDay    Int
  voteMinute Int
  /// Ngày game xong thi công (khi đang BUILDING).
  doneDay    Int?
  /// Số mẻ vữa bà con phụ hồ đã trộn đúng (UC-J6) — đủ `crewMixes` thì xong sớm.
  mixes      Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([roomId, status])
}

enum WalletKind {
  /// 💵 Tiền mặt của người chơi ("player:<id>") — ví có từ trước, số dư giữ nguyên.
  PLAYER
  /// 🏦 Tài khoản ngân hàng của người chơi ("bank:<id>"): nhận chuyển khoản, rút/gửi ở ATM (DESIGN §2).
  PLAYER_BANK
  /// 🏗️ Quỹ xóm ("fund:<roomId>"): phí chợ một phần + hàng xóm góp, chi cho công trình chung (UC-J5).
  ROOM_FUND
  /// 🔒 Tiền giữ hộ của một hợp đồng ("escrow:<contractId>"): thưởng + cọc, nghiệm thu xong mới chi (KIENTRUC §3).
  ESCROW
  SYSTEM
}

/// Số dư là cache của sổ cái; chỉ được đổi cùng transaction với LedgerEntry.
model Wallet {
  id      String        @id @default(uuid(7)) @db.Uuid
  kind    WalletKind
  /// "player:<playerId>" (tiền mặt), "bank:<playerId>" (ngân hàng) hoặc "system:<tên>".
  key     String        @unique
  balance BigInt        @default(0)
  entries LedgerEntry[]
}

/// Sổ cái kép: tổng amount của một txId luôn bằng 0.
model LedgerEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  txId      String   @db.Uuid
  walletId  String   @db.Uuid
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  amount    BigInt
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([txId])
}

enum BusinessStatus {
  OPEN
  CLOSED
}

model Business {
  id          String          @id @default(uuid(7)) @db.Uuid
  ownerId     String          @db.Uuid
  owner       Player          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  equipmentId String
  productId   String
  lotId       String?
  /// Thực đơn: variantId → { on, price } (docs/USECASES.md UC-F2).
  menu        Json            @default("{}")
  status      BusinessStatus  @default(CLOSED)
  reputation  Float
  demandCarry Float           @default(0)
  /// Tiền thuê chỗ trả trước khi mở hàng: ngày và lô đã trả gần nhất.
  rentPaidDay Int?
  rentLotId   String?
  /// Độ mòn xe đẩy/quầy 0–1 (Luật 2.2): bán càng nhiều càng mòn, sửa ở vựa xe Ông Sáu.
  wear        Float           @default(0)
  /// Ngày game gần nhất tổ chức khai trương (sự kiện người chơi tạo, có thời gian chờ).
  promoDay    Int?
  createdAt   DateTime        @default(now())
  /// Nhân viên đang thuê (KIENTRUC §2) — nhiều người, tối đa theo cấp tiệm (docs/IA.md bước E).
  employees   Employee[]
  /// Cấp tiệm (content.shopLevels): nâng cấp → đông khách hơn, thuê thêm người.
  level       Int             @default(1)
  /// Kho riêng của cửa hàng.
  inventory   InventoryItem[]
  /// Mở tiệm (UC-F12): tên quán đăng ký hộ kinh doanh; phút game tuyệt đối hồ sơ được duyệt (null = chưa nộp).
  shopName    String?
  licenseAt   Int?
  /// ATTP: đã tập huấn; giờ đoàn kiểm tra tới (phút tuyệt đối); đã có giấy chứng nhận.
  trained     Boolean         @default(false)
  inspectAt   Int?
  certified   Boolean         @default(false)
  /// Đã làm biển hiệu tên quán.
  signed      Boolean         @default(false)
  /// Ảnh quầy đăng lên nhóm xóm (UC-M8): khách ghé ×adMul tới phút `adUntil` của ngày `adDay`.
  adDay       Int?
  adUntil     Int?
  adMul       Float           @default(1)
  /// Đánh giá riêng của cửa hàng này (góp ý đợt 2: mỗi tiệm / quầy một sổ đánh giá).
  reviews     Review[]

  @@index([ownerId])
}

enum LeaseStatus {
  ACTIVE
  /// Tự trả nhà (hoàn cọc).
  ENDED
  /// Hết tiền trả tiền nhà, cọc trừ hết — chủ nhà lấy lại.
  EVICTED
}

/// Hợp đồng thuê nhà mặt tiền (UC-F12): cọc giữ trong ví "deposit:<id>", tiền nhà tính mỗi ngày dù mở hay đóng.
model Lease {
  id         String      @id @default(uuid(7)) @db.Uuid
  roomId     String      @db.Uuid
  lotId      String
  ownerId    String      @db.Uuid
  deposit    Int
  signedDay  Int
  endedDay   Int?
  status     LeaseStatus @default(ACTIVE)
  /// Đòi tiền nhà (UC-F13): đã trả tiền nhà tới hết ngày này.
  paidDay    Int
  /// Ngày hẹn trả (hạn trong ngày theo content.shopSetup.rent.dueMinute); null = chưa hẹn.
  promiseDay Int?
  /// Phí trễ đã chốt lúc xin hẹn, trả cùng tiền nhà.
  lateFee    Int         @default(0)
  /// Số lần trễ hạn (đủ evictAfterStrikes thì dẹp tiệm).
  strikes    Int         @default(0)
  createdAt  DateTime    @default(now())

  @@index([roomId, lotId, status])
  @@index([ownerId, status])
}

/// Nhân viên NPC đứng quầy thay khi chủ rời quầy / thoát game (docs/KIENTRUC.md §2).
model Employee {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Id người trong content.staff.people.
  staffId    String
  /// Ca trong content.staff.shifts.
  shiftId    String
  hiredDay   Int
  createdAt  DateTime @default(now())

  @@index([businessId])
}

/// Một phiên bán thay của nhân viên (để báo "Trong lúc bạn vắng" + phiếu ca).
model StaffShift {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @db.Uuid
  ownerId    String   @db.Uuid
  staffId    String
  day        Int
  fromMinute Int
  toMinute   Int
  served     Int
  wrong      Int
  lost       Int
  revenue    Int
  wages      Int
  createdAt  DateTime @default(now())

  @@index([ownerId, createdAt])
}

enum ContractStatus {
  /// Đang treo trên bảng, chưa ai nhận.
  OPEN
  /// Đã nhận (tiền thưởng + cọc nằm trong escrow), chưa chuẩn bị hàng.
  TAKEN
  /// Đã làm đủ hàng, đang mang đi giao.
  READY
  DONE
  /// Trễ hạn / bỏ ngang: hoàn thưởng cho người đăng, mất cọc, trừ tin cậy.
  FAILED
  /// Hết hạn mà không ai nhận.
  EXPIRED
}

/// Việc trên bảng việc xóm (KIENTRUC §3): NPC đăng mỗi ngày, người chơi nhận → làm → giao tận nơi trước hạn.
model Contract {
  id         String         @id @default(uuid(7)) @db.Uuid
  roomId     String         @db.Uuid
  day        Int
  /// Mẫu việc trong content.contracts.templates.
  templateId String
  qty        Int
  reward     Int
  deposit    Int
  deadline   Int
  takerId    String?        @db.Uuid
  status     ContractStatus @default(OPEN)
  createdAt  DateTime       @default(now())
  doneAt     DateTime?

  @@index([roomId, day])
  @@index([takerId, status])
}

enum GigStatus {
  /// Đang treo trên bảng (tiền công nằm trong ví giữ hộ của người đăng).
  OPEN
  /// Đã có người nhận (cọc người nhận cũng vào ví giữ hộ).
  TAKEN
  /// Đã nộp việc, chờ người đăng nghiệm thu (quá hạn thì tự trả).
  SUBMITTED
  /// Đã trả tiền cho người nhận (nghiệm thu / tự trả / phân xử người nhận thắng).
  DONE
  /// Phân xử người đăng thắng: hoàn tiền công cho người đăng.
  REFUNDED
  /// Người đăng gỡ khi chưa ai nhận.
  CANCELLED
  /// Hết hạn mà chưa ai nhận: hoàn tiền người đăng.
  EXPIRED
  /// Người nhận trễ hạn / bỏ ngang: hoàn tiền người đăng, người nhận mất cọc.
  FAILED
}

/// Việc người chơi đăng cho nhau (docs/KIENTRUC.md §3 — 1.20b, UC-M8). Hiện có: 📸 chụp ảnh quầy.
model Gig {
  id         String    @id @default(uuid(7)) @db.Uuid
  roomId     String    @db.Uuid
  day        Int
  kind       String
  posterId   String    @db.Uuid
  /// Quầy cần chụp (của người đăng) + chỗ bán lúc đăng.
  businessId String    @db.Uuid
  lotId      String
  reward     Int
  deposit    Int
  fee        Int
  /// Hạn làm (phút trong ngày `day`).
  deadline   Int
  takerId    String?   @db.Uuid
  status     GigStatus @default(OPEN)
  /// Đã thuê máy ảnh cho việc này (thuê một lần).
  cameraPaid Boolean   @default(false)
  /// Điểm từng tấm đã chụp (0–100).
  shots      Int[]     @default([])
  quality    Int?
  stars      Int?
  /// Hạn nghiệm thu (phút tuyệt đối = day × 1440 + phút).
  reviewBy   Int?
  /// Kết quả: "accepted" | "auto" | "dispute_taker" | "dispute_poster".
  verdict    String?
  createdAt  DateTime  @default(now())
  doneAt     DateTime?

  @@index([roomId, day])
  @@index([takerId, status])
  @@index([posterId, status])
}

/// Tồn kho theo lô nhập (batchDay) để tính hàng hỏng và xuất FIFO.
/// Kho RIÊNG từng cửa hàng (docs/IA.md bước D); `playerId` = chủ (dời ngày lô khi chuyển xóm, hỏng cuối ngày).
model InventoryItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  playerId   String   @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Id nguyên liệu (content ingredients).
  itemId     String
  batchDay   Int
  qty        Int

  @@unique([businessId, itemId, batchDay])
  @@index([playerId])
}

/// Hàng đang chuyển giữa hai cửa hàng của một chủ (bấm chuyển, tới sau vài phút game — docs/IA.md bước D).
model StockTransfer {
  id        String   @id @default(uuid(7)) @db.Uuid
  ownerId   String   @db.Uuid
  fromId    String   @db.Uuid
  toId      String   @db.Uuid
  itemId    String
  batchDay  Int
  qty       Int
  /// Phút game tuyệt đối hàng tới nơi.
  arriveAt  Int
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model DailyReport {
  id           String   @id @default(uuid(7)) @db.Uuid
  playerId     String   @db.Uuid
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  day          Int
  revenue      Int
  /// Tiền boa khi phục vụ khách kịp.
  tips         Int      @default(0)
  /// Lãi ngân hàng nhận cuối ngày (rất nhỏ, có trần).
  interest     Int      @default(0)
  /// Phí chợ/thuế, điện nước, sửa xe, khai trương… (chỗ tiêu ngoài nhập hàng và thuê chỗ).
  fees         Int      @default(0)
  /// Lương nhân viên bán thay (UC-M6) — tách khỏi `fees` để Sổ sách thấy rõ (docs/IA.md bước C).
  staffWages   Int      @default(0)
  /// Điện nước tiệm theo giờ mở cửa.
  utilities    Int      @default(0)
  stockCost    Int
  rent         Int
  wages        Int
  spoiledQty   Int
  spoiledValue Int
  served       Int
  /// Món làm sai phải giảm giá.
  wrong        Int      @default(0)
  lost         Int
  satisfaction Float
  reputation   Float
  moneyEnd     BigInt
  createdAt    DateTime @default(now())

  @@unique([playerId, day])
}

/// Sổ đánh giá quầy (docs/USECASES.md UC-F11): khách NPC hoặc người chơi chấm sao + vài chữ; chủ quầy trả lời một lần.
/// Gắn với chủ quầy (không xoá khi đổi nghề — tiếng tăm đi theo người).
model Review {
  id         String    @id @default(uuid(7)) @db.Uuid
  ownerId    String    @db.Uuid
  owner      Player    @relation("ReviewsReceived", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Cửa hàng được đánh giá (null = đánh giá cũ không còn cửa hàng).
  businessId String?   @db.Uuid
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  /// Món của quầy nào (productId) lúc được đánh giá.
  productId  String
  /// Người chơi viết (null = khách NPC).
  authorId   String?   @db.Uuid
  authorName String
  stars      Int
  text       String
  day        Int
  reply      String?
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([authorId, businessId, day])
  @@index([ownerId, createdAt])
  @@index([businessId, createdAt])
}

/// Thay cho analytics: ghi sự kiện để query khi cần (docs/PLAN.md, nguyên tắc làm một mình).
model GameEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  playerId  String?  @db.Uuid
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

/// Độ thân thiết người chơi – NPC (UC-D2): chào hỏi, mua bán thường xuyên thì thân hơn.
model NpcRelation {
  playerId     String @db.Uuid
  player       Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  npcId        String
  friendship   Int    @default(0)
  /// Ngày game gần nhất đã chào (mỗi ngày chỉ tính một lần).
  lastGreetDay Int    @default(0)

  @@id([playerId, npcId])
}

/// "Chuyện của tôi" (docs/THEGIOI.md §1): mốc đời người chơi, mỗi mốc (key) ghi một lần với câu đã viết sẵn.
model StoryEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  playerId  String   @db.Uuid
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// id mốc trong content.story / thành tựu (`ach:<id>`), có thể kèm hậu tố (đổi nghề theo từng nghề).
  key       String
  /// Ngày game xảy ra.
  day       Int
  emoji     String
  text      String
  createdAt DateTime @default(now())

  @@unique([playerId, key])
  @@index([playerId, day])
}

/// Khách quen (docs/KIENTRUC.md §1): cư dân có tên đã mua ở quầy của người chơi bao nhiêu lần.
model ResidentVisit {
  id           String @id @default(uuid(7)) @db.Uuid
  ownerId      String @db.Uuid
  owner        Player @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Id cư dân trong content.residents.
  residentId   String
  visits       Int    @default(0)
  lastDay      Int    @default(0)
  /// Bị làm sai / bỏ về liên tiếp (khách quen giận khi đủ chuỗi).
  streakWrong  Int    @default(0)
  /// Ngày thành khách quen ❤️ (null = chưa / đã giận).
  regularSince Int?

  @@unique([ownerId, residentId])
}
