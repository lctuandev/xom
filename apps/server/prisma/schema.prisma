generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Tài khoản đăng nhập bằng username + mật khẩu (docs/PLAN.md §3.8).
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
  player       Player?
}

/// Refresh token xoay vòng; chỉ lưu hash.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

/// Nhân vật trong game của một tài khoản.
model Player {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @unique @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  roomId      String?  @db.Uuid
  room        Room?    @relation(fields: [roomId], references: [id])
  /// Việc làm thuê đang làm (content job id), null = không đi làm.
  jobId       String?
  createdAt   DateTime @default(now())

  businesses Business[]
  inventory  InventoryItem[]
  reports    DailyReport[]
}

/// Một "xóm": có đồng hồ riêng. Phase 1 mỗi người chơi một xóm riêng.
model Room {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  day       Int      @default(1)
  /// Phút trong ngày (game).
  minute    Int
  createdAt DateTime @default(now())
  players   Player[]
}

enum WalletKind {
  PLAYER
  SYSTEM
}

/// Số dư là cache của sổ cái; chỉ được đổi cùng transaction với LedgerEntry.
model Wallet {
  id      String        @id @default(uuid(7)) @db.Uuid
  kind    WalletKind
  /// "player:<playerId>" hoặc "system:<tên>".
  key     String        @unique
  balance BigInt        @default(0)
  entries LedgerEntry[]
}

/// Sổ cái kép: tổng amount của một txId luôn bằng 0.
model LedgerEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  txId      String   @db.Uuid
  walletId  String   @db.Uuid
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  amount    BigInt
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([txId])
}

enum BusinessStatus {
  OPEN
  CLOSED
}

model Business {
  id          String         @id @default(uuid(7)) @db.Uuid
  ownerId     String         @db.Uuid
  owner       Player         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  equipmentId String
  productId   String
  lotId       String?
  price       Int
  status      BusinessStatus @default(CLOSED)
  reputation  Float
  demandCarry Float          @default(0)
  /// Tiền thuê chỗ trả trước khi mở hàng: ngày và lô đã trả gần nhất.
  rentPaidDay Int?
  rentLotId   String?
  createdAt   DateTime       @default(now())

  @@index([ownerId])
}

/// Tồn kho theo lô nhập (batchDay) để tính hàng hỏng và xuất FIFO.
model InventoryItem {
  id        String @id @default(uuid(7)) @db.Uuid
  playerId  String @db.Uuid
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  productId String
  batchDay  Int
  qty       Int

  @@unique([playerId, productId, batchDay])
}

model DailyReport {
  id           String   @id @default(uuid(7)) @db.Uuid
  playerId     String   @db.Uuid
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  day          Int
  revenue      Int
  stockCost    Int
  rent         Int
  wages        Int
  spoiledQty   Int
  spoiledValue Int
  served       Int
  lost         Int
  satisfaction Float
  reputation   Float
  moneyEnd     BigInt
  createdAt    DateTime @default(now())

  @@unique([playerId, day])
}

/// Thay cho analytics: ghi sự kiện để query khi cần (docs/PLAN.md, nguyên tắc làm một mình).
model GameEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  playerId  String?  @db.Uuid
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}
