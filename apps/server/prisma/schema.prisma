generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Tài khoản đăng nhập bằng username + mật khẩu (docs/PLAN.md §3.8).
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
  player       Player?
}

/// Refresh token xoay vòng; chỉ lưu hash.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

/// Nhân vật trong game của một tài khoản.
model Player {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @unique @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  roomId      String?  @db.Uuid
  room        Room?    @relation(fields: [roomId], references: [id])
  /// Việc làm thuê đang làm (content job id), null = không đi làm.
  jobId       String?
  /// Bước kịch bản người mới đang ở (content tutorial step id).
  tutorial    String   @default("gap_chu_bay")
  /// Kinh nghiệm tích luỹ từ làm thật (docs/DESIGN.md §4) — cấp độ suy ra từ đây.
  xp          Int      @default(0)
  /// Điểm kỹ năng (DESIGN §4): { tay_nhanh, nho_mon, an_noi } — tăng nhờ làm thật.
  skills      Json     @default("{}")
  createdAt   DateTime @default(now())

  businesses Business[]
  relations  NpcRelation[]
  inventory  InventoryItem[]
  reports    DailyReport[]
}

/// Một "xóm": có đồng hồ riêng. Đăng ký thì có xóm riêng; vào xóm bạn bằng `code` (UC-J1).
model Room {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  day       Int      @default(1)
  /// Phút trong ngày (game).
  minute    Int
  createdAt DateTime @default(now())
  players   Player[]
}

enum WalletKind {
  /// 💵 Tiền mặt của người chơi ("player:<id>") — ví có từ trước, số dư giữ nguyên.
  PLAYER
  /// 🏦 Tài khoản ngân hàng của người chơi ("bank:<id>"): nhận chuyển khoản, rút/gửi ở ATM (DESIGN §2).
  PLAYER_BANK
  SYSTEM
}

/// Số dư là cache của sổ cái; chỉ được đổi cùng transaction với LedgerEntry.
model Wallet {
  id      String        @id @default(uuid(7)) @db.Uuid
  kind    WalletKind
  /// "player:<playerId>" (tiền mặt), "bank:<playerId>" (ngân hàng) hoặc "system:<tên>".
  key     String        @unique
  balance BigInt        @default(0)
  entries LedgerEntry[]
}

/// Sổ cái kép: tổng amount của một txId luôn bằng 0.
model LedgerEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  txId      String   @db.Uuid
  walletId  String   @db.Uuid
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  amount    BigInt
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([txId])
}

enum BusinessStatus {
  OPEN
  CLOSED
}

model Business {
  id          String         @id @default(uuid(7)) @db.Uuid
  ownerId     String         @db.Uuid
  owner       Player         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  equipmentId String
  productId   String
  lotId       String?
  /// Thực đơn: variantId → { on, price } (docs/USECASES.md UC-F2).
  menu        Json           @default("{}")
  status      BusinessStatus @default(CLOSED)
  reputation  Float
  demandCarry Float          @default(0)
  /// Tiền thuê chỗ trả trước khi mở hàng: ngày và lô đã trả gần nhất.
  rentPaidDay Int?
  rentLotId   String?
  /// Độ mòn xe đẩy/quầy 0–1 (Luật 2.2): bán càng nhiều càng mòn, sửa ở vựa xe Ông Sáu.
  wear        Float          @default(0)
  /// Ngày game gần nhất tổ chức khai trương (sự kiện người chơi tạo, có thời gian chờ).
  promoDay    Int?
  createdAt   DateTime       @default(now())

  @@index([ownerId])
}

/// Tồn kho theo lô nhập (batchDay) để tính hàng hỏng và xuất FIFO.
model InventoryItem {
  id       String @id @default(uuid(7)) @db.Uuid
  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Id nguyên liệu (content ingredients).
  itemId   String
  batchDay Int
  qty      Int

  @@unique([playerId, itemId, batchDay])
}

model DailyReport {
  id           String   @id @default(uuid(7)) @db.Uuid
  playerId     String   @db.Uuid
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  day          Int
  revenue      Int
  /// Tiền boa khi phục vụ khách kịp.
  tips         Int      @default(0)
  /// Lãi ngân hàng nhận cuối ngày (rất nhỏ, có trần).
  interest     Int      @default(0)
  /// Phí chợ/thuế, điện nước, sửa xe, khai trương… (chỗ tiêu ngoài nhập hàng và thuê chỗ).
  fees         Int      @default(0)
  stockCost    Int
  rent         Int
  wages        Int
  spoiledQty   Int
  spoiledValue Int
  served       Int
  /// Món làm sai phải giảm giá.
  wrong        Int      @default(0)
  lost         Int
  satisfaction Float
  reputation   Float
  moneyEnd     BigInt
  createdAt    DateTime @default(now())

  @@unique([playerId, day])
}

/// Thay cho analytics: ghi sự kiện để query khi cần (docs/PLAN.md, nguyên tắc làm một mình).
model GameEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  playerId  String?  @db.Uuid
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

/// Độ thân thiết người chơi – NPC (UC-D2): chào hỏi, mua bán thường xuyên thì thân hơn.
model NpcRelation {
  playerId     String @db.Uuid
  player       Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  npcId        String
  friendship   Int    @default(0)
  /// Ngày game gần nhất đã chào (mỗi ngày chỉ tính một lần).
  lastGreetDay Int    @default(0)

  @@id([playerId, npcId])
}
